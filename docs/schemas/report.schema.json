{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParkingReport",
  "description": "Skema data laporan harian shift parkir motor pabrik",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Identifier unik laporan di database"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Tanggal laporan shift (format: YYYY-MM-DD)"
    },
    "total_motorcycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Total unit motor terhitung pada shift"
    },
    "officer_name": {
      "type": "string",
      "description": "Nama petugas penanggung jawab shift"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Catatan kondisi operasional lapangan"
    },
    "photo_status": {
      "type": "string",
      "enum": ["VERIFIED", "DUPLICATE", "PENDING", "NO_PHOTO"],
      "description": "Status verifikasi perceptual hash foto bukti"
    }
  },
  "required": ["date", "total_motorcycles"]
}
